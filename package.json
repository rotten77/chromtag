    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/chrome": "0.3.7",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "typescript": "~6.0.0",
    "vitest": "5.1.0"
  }
}
